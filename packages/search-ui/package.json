{
  "name": "@newjersey/search-ui",
  "version": "0.1.0",
  "description": "React hooks and components for the NJIA faceted search toolkit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
