  },
  "dependencies": {
    "@newjersey/search-core": "^0.1.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "testcontainers": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0"
  }
