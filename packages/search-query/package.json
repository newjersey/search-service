{
  "name": "@newjersey/search-query",
  "version": "0.1.0",
  "description": "Postgres query builder for the NJIA faceted search toolkit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
